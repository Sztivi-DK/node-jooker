<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jooker Safety Team</title>

    <link rel="stylesheet" href="style.css">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

    <header>
        <div class="container nav-container">

            <div class="logo">
                JOOKER<span>TEAM</span>
            </div>
            <h1><%= title %></h1>
            <nav>
                <ul>
                    <li><a href="/">Kezdőlap</a></li>
                    <li><a href="/valami">Valami</a></li>
                    <li><a href="/rolunk">Rólunk</a></li>
                    <li><a href="/szolgaltatasok">Szolgáltatások</a></li>
                    <li><a href="/aktualis">Aktuális</a></li>
                    <li><a href="/referenciak">Referenciák</a></li>
                    <li><a href="/kapcsolat">Kapcsolat</a></li>
                </ul>
            </nav>

        </div>
    </header>

    <section class="hero">

        <div class="hero-overlay"></div>

        <div class="hero-content">
            <h1>Professzionális Biztonsági Megoldások</h1>

            <p>
                Több éves szakmai tapasztalattal biztosítjuk
                partnereink személyi és vagyonvédelmi igényeit.
            </p>

            <a href="#kapcsolat" class="btn">
                Kapcsolatfelvétel
            </a>
        </div>

    </section>

    <section id="rolunk" class="section">
        <div class="container">

            <h2>Rólunk</h2>

            <p>
                Cégünk célja a magas színvonalú biztonsági szolgáltatások
                biztosítása, amely megfelel a modern kor követelményeinek.
                Megbízható szakembereinkkel és korszerű technikai háttérrel
                támogatjuk ügyfeleinket.
            </p>

        </div>
    </section>

    <section id="szolgaltatasok" class="section gray">

        <div class="container">

            <h2>Szolgáltatásaink</h2>

            <div class="services-grid">

                <div class="card">
                    <h3>Objektumvédelem</h3>
                    <p>
                        Telephelyek, irodaházak és ipari létesítmények
                        professzionális őrzése.
                    </p>
                </div>

                <div class="card">
                    <h3>Rendezvénybiztosítás</h3>
                    <p>
                        Kulturális, sport és céges események
                        teljes körű biztosítása.
                    </p>
                </div>

                <div class="card">
                    <h3>Személyvédelem</h3>
                    <p>
                        Diszkrét és magas szintű személyvédelmi
                        szolgáltatások.
                    </p>
                </div>

            </div>

        </div>

    </section>

    <section id="aktualis" class="section">

        <div class="container">

            <h2>Aktuális</h2>

            <div class="news-grid">

                <div class="news-card">
                    <span>2026</span>
                    <h3>Új biztonságtechnikai fejlesztések</h3>
                    <p>
                        Modern ellenőrzési és kommunikációs rendszerek
                        bevezetése.
                    </p>
                </div>

                <div class="news-card">
                    <span>2026</span>
                    <h3>Rendezvénybiztosítás bővítése</h3>
                    <p>
                        Megnövelt kapacitással vállalunk országos
                        rendezvényeket.
                    </p>
                </div>

            </div>

        </div>

    </section>

    <section id="referenciak" class="section gray">

        <div class="container">

            <h2>Referenciák</h2>

            <div class="references-grid">

                <div class="ref-card">Irodaházak védelme</div>
                <div class="ref-card">Logisztikai központok</div>
                <div class="ref-card">Sportesemények</div>
                <div class="ref-card">Kulturális rendezvények</div>
                <div class="ref-card">Filmforgatások</div>
                <div class="ref-card">Személyvédelmi projektek</div>

            </div>

        </div>

    </section>

    <section id="kapcsolat" class="section">

        <div class="container">

            <h2>Kapcsolat</h2>

            <div class="contact-wrapper">

                <div>
                    <h3>Elérhetőségek</h3>

                    <p>+36 30 123 4567</p>
                    <p>info@jookerteam.hu</p>
                    <p>Budapest, Magyarország</p>
                </div>

                <form>

                    <input type="text" placeholder="Név">

                    <input type="email" placeholder="Email">

                    <textarea placeholder="Üzenet"></textarea>

                    <button type="submit">
                        Küldés
                    </button>

                </form>

            </div>

        </div>

    </section>

    <footer>

        <div class="container">

            <p>
                © 2026 Jooker Safety Team. Minden jog fenntartva.
            </p>

        </div>

    </footer>

</body>
</html>