<%- include('../partials/header') %>

<section class="section">
    <div class="container">
        <h2>Szolgáltatások kezelése</h2>

        <% for (let service of services) { %>
            <div>
                <h3><%= service.name %></h3>

                <p>
                    Állapot:
                    <%= service.active ? 'Aktív' : 'Inaktív' %>
                </p>
                
                <% if (service.active) { %>
                    <form action="/admin/szolgaltatasok/<%= service.id %>/deactivate" method="POST">
                        <button type="submit">Deaktiválás</button>
                    </form>
                <% } else { %>
                    <form action="/admin/szolgaltatasok/<%= service.id %>/restore" method="POST">
                        <button type="submit">Visszaállítás</button>
                    </form>
                <% } %>
            </div>
        <% } %>
    </div>
</section>

<%- include('../partials/footer') %>