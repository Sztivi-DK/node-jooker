<%- include('../partials/header') %>

<section class="section">
    <div class="container">

        <h2><%= service.name %></h2>

        <% if (service.image) { %>
            <img src="<%= service.image %>" alt="<%= service.name %>">
        <% } %>

        <p><%= service.detailed_description %></p>
        
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <p><strong>Állapot: </strong><%= service.active ? 'Aktív' : 'Inaktív' %></p>

            <div class="form-actions">
                <button
                    type="button"
                    onclick="window.location.href='/admin/szolgaltatasok/<%= service.id %>/edit'">Szerkesztés
                </button>

                <% if (service.active) { %>
                    <form action="/admin/szolgaltatasok/<%= service.id %>/deactivate" method="POST">
                        <button type="submit">Deaktiválás</button>
                    </form>
                <% } else { %>
                    <form action="/admin/szolgaltatasok/<%= service.id %>/restore" method="POST">
                        <button type="submit">Visszaállítás</button>
                    </form>
                <% } %>

                <button
                    type="button"
                    onclick="window.location.href='/admin/szolgaltatasok'">Vissza
                </button>
            </div>
        <% } %>

    </div>
</section>

<%- include('../partials/footer') %>