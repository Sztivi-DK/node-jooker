<%- include('../partials/header') %>

<section id="referenciak" class="section gray">
    <% if (reference) { %> 
        <div class="container">
            <article>
                <h2><%= reference.title %></h2>
                <p><strong><%= reference.intro %></strong></p>
                <% for (let line of reference.content) { %>
                    <p><%= line %></p>
                <% } %>
            </article>
        </div>
    <% } else { %>
        <div class="container notfound">
            <h2>Nem található</h2>
            <p>A kért referencia nem szerepel az adatbázisban.</p>
        </div>
    <% } %>
</section>

<%- include('../partials/footer') %>