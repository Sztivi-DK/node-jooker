<%- include('../partials/header') %>

<section id="referenciak" class="section gray">
    <div class="container">
        <article>
            <h2><%= reference.title %></h2>
            <% if (reference.image) { %>
                <img src="<%= reference.image %>" alt="<%= reference.title %>">
            <% } %>

            <% if (reference.date) { %>
                <p><strong>Dátum:</strong> <%= reference.date.toLocaleDateString('hu-HU') %></p>
            <% } %>
            <p><strong>Helyszín:</strong> <%= reference.location %></p>
            <p><%= reference.detailed_description %></p>
        </article>
    </div>
</section>

<%- include('../partials/footer') %>