<%- include('../partials/header') %>

<section id="kapcsolat" class="section">
    <div class="container">
        <h2>Kapcsolat</h2>

        <div class="contact-wrapper">
            <div>
                <h3>Elérhetőségek</h3>
                <p>+36 30 123 4567</p>
                <p>info@jookerteam.hu</p>
                <p>Budapest, Magyarország</p>
            </div>

            <form action="/kapcsolat" method="POST">

                <div>
                    <% if (typeof errors !== 'undefined') { %>
                        <% for (const key in errors) { %>
                            <p><%= errors[key] %></p>
                        <% } %>
                    <% } %>
                </div> 

                <input type="text" name="name" placeholder="Név">
                <input type="text" name="email" placeholder="Email">
                <textarea name="message" placeholder="Üzenet"></textarea>
                <button type="submit">
                    Küldés
                </button>
            </form>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>