<%- include('../partials/header') %>

<section class="section">
    <div class="container">
        <h2>Új szolgáltatás</h2>

        <% if (typeof errors !== 'undefined') { %>
            <% for (const key in errors) { %>
                <p><%= errors[key] %></p>
            <% } %>
        <% } %>

        <form action="/admin/szolgaltatasok/create" method="POST">
            <input
                type="text"
                name="name"
                placeholder="Név"
            >

            <input
                type="text"
                name="short_description"
                placeholder="Rövid leírás"
            >

            <textarea
                name="detailed_description"
                placeholder="Részletes leírás"
            ></textarea>

            <input
                type="text"
                name="image"
                placeholder="Kép elérési útja"
            >

            <div class="form-actions">
                <button type="submit">Mentés</button>
                <button type="button"onclick="window.location.href='/admin/szolgaltatasok'">Mégse</button>
            </div>

        </form>
    </div>
</section>

<%- include('../partials/footer') %>