<%- include('../partials/header') %>

<section id="szolgaltatasok" class="section gray">
    <div class="container">
        <h2>Szolgáltatásaink</h2>

        <div class="services-grid"> 
            <% for (const srv of services) { %>    
                <div class="card">
                    <% if (srv.image) { %><img src="<%= srv.image %>" alt="<%= srv.name %>"><% } %>
                    <h3><%= srv.name %></h3>
                    <p><%= srv.short_description %></p>
                    <a href="/szolgaltatasok/<%= srv.id %>">Részletek</a>
                </div>
            <% } %>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>