<%- include('../partials/header') %>

<section id="szolgaltatasok" class="section gray">
    <div class="container">
        <h2>Szolgáltatásaink</h2>

        <div class="services-grid"> 
            <% for (const srv of services) { %>    
                <div class="card">
                    <h3><%= srv.name %></h3>
                    <p><%= srv.description %></p>
                </div>
            <% } %>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>