<%- include('../partials/header') %>

<section id="referenciak" class="section gray">
    <div class="container">
        <h2>Referenciák</h2>

        <div class="references-grid">
            <% for (let ref of references) {%>
                <div class="ref-card">
                    <% if (ref.image) { %>
                        <img src="<%= ref.image %>" alt="<%= ref.title %>">
                    <% } %>
                    <h3><%= ref.title %></h3>
                    <p><%= ref.short_description %></p>

                    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                        <p>
                            Állapot: <%= ref.active ? 'Aktív' : 'Inaktív' %>
                        </p>
                    <% } %>

                    <a href="<%= typeof isAdmin !== 'undefined' && isAdmin
                        ? '/admin/referenciak/' + ref.id + '/edit'
                        : '/referenciak/' + ref.id %>">
                        Elolvasom
                    </a>
                </div>
            <% } %>
        </div>

        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <div class="form-actions">
                <button
                    type="button"
                    onclick="window.location.href='/admin/referenciak/create'"
                >
                    Új referencia
                </button>
            </div>
        <% } %>

    </div>
</section>

<%- include('../partials/footer') %>
