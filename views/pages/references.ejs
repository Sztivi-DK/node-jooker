<%- include('../partials/header') %>

<section id="referenciak" class="section gray">
    <div class="container">
        <h2>Referenciák</h2>

        <div class="references-grid">
            <% for (let ref of references) {%>
                <div class="ref-card">
                    <h3><%= ref.title %></h3>
                    <p><%= ref.intro %></p>
                    <a href="/referenciak/<%= ref.id %>">Elolvasom</a>
                </div>
            <% } %>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
