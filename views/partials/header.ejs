<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> Jooker Safety Team</title>

    <link rel="stylesheet" href="/style.css">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<header>
    <div class="container nav-container">

        <div class="logo">
            JOOKER<span>TEAM</span>
        </div>
        <h1><%= title %></h1>
        <nav>
            <ul>
                <li><a href="/">Rólunk</a></li>
                <li>
                    <a href="<%= typeof isAdmin !== 'undefined' && isAdmin
                        ? '/admin/szolgaltatasok' : '/szolgaltatasok' %>">Szolgáltatások
                    </a>
                </li>
                <li>
                    <a href="<%= typeof isAdmin !== 'undefined' && isAdmin
                        ? '/admin/referenciak' : '/referenciak' %>">Referenciák
                    </a>
                </li>
                <li>
                    <a href="<%= typeof isAdmin !== 'undefined' && isAdmin
                        ? '/admin/kapcsolatok' : '/kapcsolat' %>">Kapcsolat
                    </a>
                </li>

                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                    <li><a href="/logout">Kilépés</a></li>
                <% } else { %>
                    <li><a href="/login">Belépés</a></li>
                <% } %>

            </ul>
        </nav>

    </div>
</header>
